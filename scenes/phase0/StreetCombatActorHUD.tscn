[sub_resource type="Shader" id="minimap_shader"]
code = "shader_type canvas_item;\nvoid fragment() {\n    vec2 centered = UV - vec2(0.5);\n    vec4 tex = texture(TEXTURE, UV);\n    if (length(centered) > 0.5) { tex.a = 0.0; }\n    COLOR = tex;\n}"

