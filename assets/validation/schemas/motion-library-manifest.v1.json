{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paralls.dev/schemas/motion-library-manifest.v1.json",
  "title": "Motion Library Manifest v1",
  "type": "object",
  "required": ["motion_library_id", "skeleton_profile_id", "animation_library_ref", "clips", "semantic_actions", "source_digest", "qualification_report_ref", "qualification_status"],
  "properties": {
    "motion_library_id": {"type": "string", "pattern": "^motionlib:[a-z0-9._-]+@[0-9]+$"},
    "skeleton_profile_id": {"type": "string", "minLength": 1},
    "animation_library_ref": {"type": "string", "minLength": 1},
    "clips": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/clip"}},
    "semantic_actions": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/semanticAction"}},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualification_report_ref": {"type": "string", "minLength": 1},
    "qualification_status": {"type": "string", "enum": ["candidate", "approved", "rejected"]}
  },
  "$defs": {
    "clip": {
      "type": "object",
      "required": ["clip_ref", "duration_seconds", "track_count", "canonical_bone_ids", "loop_mode"],
      "properties": {
        "clip_ref": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "track_count": {"type": "integer", "minimum": 1},
        "canonical_bone_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "loop_mode": {"type": "string", "enum": ["linear", "once", "explicit_landing"]}
      },
      "additionalProperties": false
    },
    "semanticAction": {
      "type": "object",
      "required": ["clip_ref", "realization_mode", "loop_mode"],
      "properties": {
        "clip_ref": {"type": "string", "minLength": 1},
        "realization_mode": {"type": "string", "enum": ["shared_library", "retargeted_library", "package_native", "fallback"]},
        "loop_mode": {"type": "string", "enum": ["linear", "once", "explicit_landing"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
