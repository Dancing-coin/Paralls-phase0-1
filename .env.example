# Backend runtime modes
DIALOGUE_MODE=stub
TTS_MODE=stub
# Set only for explicit live provider proof; the default stub remains supported.
# `openai_compatible` expects direct WAV bytes. `dashscope_http` first receives
# DashScope JSON, then downloads its temporary WAV URL inside the backend.
TTS_PROVIDER_ENDPOINT=
TTS_PROVIDER_API_KEY=
TTS_PROVIDER_MODEL=
TTS_PROVIDER_TIMEOUT_SECONDS=15.0
TTS_DEFAULT_VOICE=default
TTS_VOICE_MAP_JSON=
TTS_OUTPUT_SAMPLE_RATE_HZ=24000
TTS_MAX_ENCODED_PAYLOAD_BYTES=1000000
# DashScope non-realtime TTS example:
# TTS_MODE=dashscope_http
# TTS_PROVIDER_ENDPOINT=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# TTS_PROVIDER_MODEL=qwen-audio-3.0-tts-flash
# TTS_VOICE_PROFILES_ENABLED=false
# TTS_VOICE_CATALOG_PATH=assets/tts/voice_catalog.json
# TTS_VOICE_BINDINGS_PATH=assets/tts/voice_bindings.json
# TTS_VOICE_REQUIRED_LANGUAGE=zh-CN
# TTS_VOICE_ENROLLMENT_ENDPOINT=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/customization

# Character text model provider
# CHARACTER_MODEL_* is the only Character runtime configuration surface.
# Provider-specific aliases such as DEEPSEEK_* / QWEN_* may be operator
# conveniences, but the Character runtime does not consume them.
CHARACTER_MODEL_PROVIDER_KIND=qwen
CHARACTER_MODEL_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHARACTER_MODEL_API_KEY=
CHARACTER_MODEL_MODEL=qwen3.7-plus
CHARACTER_MODEL_TIMEOUT_SECONDS=20.0

# Siming LLM
SIMING_LLM_MODE=http
SIMING_LLM_PROVIDER_ORDER=seed_doubao,qwen
SIMING_LLM_API_KEY=
SIMING_LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
SIMING_LLM_MODEL=doubao-seed-2.0-pro
SIMING_LLM_TIMEOUT_SECONDS=8.0

# VLA / multimodal spatial provider readiness
VLA_PROVIDER_MODE=blocked
VLA_PROVIDER_KIND=openai_compatible
VLA_PROVIDER_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
VLA_PROVIDER_API_KEY=
VLA_PROVIDER_MODEL=qwen3-vl-plus
VLA_PROVIDER_MODEL_VERSION=configured-unverified
VLA_PROVIDER_TIMEOUT_SECONDS=8.0
# OpenAI JSON mode is opt-in; leave false for DashScope-compatible Qwen routes.
VLA_PROVIDER_JSON_MODE_ENABLED=false
# Legacy single-model values above remain only for compatibility. The runtime
# route selector uses this fast/deep model surface for new slow-path work.
VLA_ADVISORY_FAST_MODEL=qwen3.7-flash
VLA_ADVISORY_FAST_MODEL_VERSION=configured-unverified
VLA_ADVISORY_FAST_TIMEOUT_SECONDS=12.0
# DashScope Qwen3.7 supports this non-standard Chat API parameter. Fast avoids
# chain-of-thought latency; deep retains it for uncertainty/conflict review.
VLA_ADVISORY_FAST_ENABLE_THINKING=false
# Production default: schedule fast only. Keep deep configured for explicit
# offline experiments; do not enable it without a separate re-admission decision.
VLA_ADVISORY_DEEP_ENABLED=false
VLA_ADVISORY_DEEP_MODEL=qwen3.7-plus
VLA_ADVISORY_DEEP_MODEL_VERSION=configured-unverified
VLA_ADVISORY_DEEP_TIMEOUT_SECONDS=20.0
VLA_ADVISORY_DEEP_ENABLE_THINKING=true
VLA_ADVISORY_DEEP_CONFIDENCE_THRESHOLD=0.55
VLA_PROVIDER_MAX_QUEUE_SIZE=8
VLA_PROVIDER_CACHE_TTL_SECONDS=30.0
# Runtime artifact readiness marker; use only opaque ref IDs, never artifact payloads.
VLA_PROVIDER_REQUIRED_ARTIFACT_REFS=
# Explicit-only live proof input. Never commit a private/signed artifact URL.
VLA_LIVE_PROOF_IMAGE_URL=
# Alternative to a URL: a repository-relative PNG/JPEG/WebP capture. The verifier
# encodes it only after --allow-live-call and never stores the payload in reports.
VLA_LIVE_PROOF_IMAGE_PATH=
# Recommended runtime-proof input: first run the Godot sampling verifier, then
# pass --use-godot-runtime-capture. This needs no image URL or image-path setting.
# The verifier accepts only its matching fresh Godot viewport capture/report pair.
VLA_LIVE_PROOF_ARTIFACT_REF=visual_artifact:vla-live-proof
VLA_PROVIDER_LIVE_PROOF_RUN_ID=
VLA_PROVIDER_LIVE_PROOF_REPORT_PATH=.harness/verification/vla-provider-live-report.json

# Non-runtime production model provider readiness
NON_RUNTIME_MODEL_MODE=disabled
NON_RUNTIME_MODEL_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
NON_RUNTIME_MODEL_API_KEY=
NON_RUNTIME_MODEL_MODEL=doubao-seed-2.0-lite
NON_RUNTIME_MODEL_TIMEOUT_SECONDS=30.0
